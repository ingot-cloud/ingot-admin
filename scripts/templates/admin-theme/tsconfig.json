{
  "include": ["src/**/*", "env.d.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "rootDir": "./src",
    "outDir": "dist",
    "declaration": true,
    "noEmit": true
  }
}
