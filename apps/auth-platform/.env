# App Title
VITE_APP_TITLE=Ingot平台身份认证
# 框架唯一标识
VITE_APP_SYMBOL=ingot
# Store默认前缀, LocalStorage SessionStorage Cookie通用
VITE_APP_STORE_PREFIX=__ingot_platform__
# 本机 DEV 留空：host-only Cookie。不要写成 .local，否则四站点会串 Cookie
VITE_APP_COOKIE_DOMAIN=
# Copyright
VITE_APP_COPYRIGHT=© 2018-{0} Ingot 版权所有
# login banner
VITE_APP_LOGIN_BANNER=/banner1024x3000.png
VITE_APP_ERROR_IMAGE=https://img.alicdn.com/imgextra/i2/O1CN01DRq3BY1nmVJzaK3AH_!!6000000005132-2-tps-146-232.png
# login title
VITE_APP_LOGIN_TITLE=登录Ingot平台
VITE_APP_LOGIN_QRCODE_TITLE=使用Ingot扫码
# login desc
VITE_APP_LOGIN_DESC=继续使用Ingot平台管理后台
# 指纹是否启用
VITE_APP_FINGERPRINT_ENABLED=true
VITE_AUTH_ENTRY=platform
VITE_APP_ADMIN_START_URL=http://platform.local:5799/auth/start
