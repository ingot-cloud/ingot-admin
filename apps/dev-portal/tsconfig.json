{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "element-plus/global"],
    "noEmit": true,
    "paths": {
      "@portal/*": ["./src/*"]
    }
  },
    "include": ["env.d.ts", "src/**/*", "src/**/*.vue", ".vitepress/**/*.ts", ".vitepress/**/*.vue"]
}
