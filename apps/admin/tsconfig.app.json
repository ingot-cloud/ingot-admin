{
  "extends": "../../tsconfig.vue-base.json",
  "include": [
    "env.d.ts",
    "auto-imports.d.ts",
    "components.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "*.d.ts",
    "../../types/**/*.d.ts",
    "../../plugins/help/src/content/types.ts",
    "../../plugins/help/src/models/help.ts"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ingot/admin-core": [
        "../../packages/admin-core/src/index.ts"
      ],
      "@ingot/org-plugin": [
        "./org-plugin.d.ts"
      ],
      "@ingot/help-plugin": [
        "./help-plugin.d.ts"
      ]
    }
  },
  "references": [
    {
      "path": "../../packages/admin-core"
    },
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/http-client"
    }
  ]
}
