{
  "extends": "../../tsconfig.vue-base.json",
  "include": ["env.d.ts", "auto-imports.d.ts", "components.d.ts", "src/**/*", "src/**/*.vue", "*.d.ts", "../../types/**/*.d.ts"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@base/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../../packages/admin-core"
    },
    {
      "path": "../../packages/shared"
    }
  ]
}
