# 前端应用编码：本地页面/布局前缀与缺省品牌，不等于 BFF appId
VITE_APP_CODE=ingot-admin
# BFF/Nacos 应用注册键；Gateway 按可信 Host/端口识别当前应用
VITE_APP_ID=tenant-admin
VITE_APP_AUTH_ENTRY=tenant
VITE_APP_EXPECTED_DOMAIN=TENANT
VITE_APP_TITLE=管理后台
# 框架唯一标识
VITE_APP_SYMBOL=ingot
# Store默认前缀, LocalStorage SessionStorage Cookie通用
VITE_APP_STORE_PREFIX=__ingot__
# 前端非认证 Cookie 留空为 host-only；BFF 认证 Cookie 由后端固定属性管理，不受此项影响
VITE_APP_COOKIE_DOMAIN=
# Cookie默认过期时间, 单位秒
VITE_APP_COOKIE_DEFAULT_EXPIRE_TIME=7200
# 默认租户
VITE_APP_TENANT=1
# Basic Token
VITE_APP_BASIC_TOKEN=aW5nb3Q6aW5nb3Q=
# Bucket Name
VITE_APP_BUCKET_NAME=ingot
# Copyright
VITE_APP_COPYRIGHT=© 2018-{0} Ingot 版权所有
# login 相关参数
VITE_APP_ERROR_IMAGE=https://img.alicdn.com/imgextra/i2/O1CN01DRq3BY1nmVJzaK3AH_!!6000000005132-2-tps-146-232.png
# 指纹是否启用
VITE_APP_FINGERPRINT_ENABLED=true
# 设置相关参数
VITE_APP_SETTINGS_COMPONENT_SIZE=default
VITE_APP_SETTINGS_SHOW_MENU=true
VITE_APP_SETTINGS_SHOW_BREADCRUMB=true
VITE_APP_SETTINGS_SHOW_COPYRIGHT=false
VITE_APP_SETTINGS_SHOW_SEARCH=true
VITE_APP_SETTINGS_SHOW_WATERMARK=true

# 同源登录页配色，不改变管理台持久偏好
VITE_APP_LOGIN_COLOR_SCHEME=light
VITE_APP_LOGIN_DESC=请输入账号和密码
