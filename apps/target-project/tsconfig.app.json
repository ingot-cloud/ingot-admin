{
  "extends": "../../tsconfig.vue-base.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "*.d.ts", "../../types/**/*.d.ts"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@ingot/admin-app": ["./admin-app-plugin.d.ts"],
      "@ingot/admin-app/plugin": ["./admin-app-plugin.d.ts"]
    }
  },
  "references": [
    {
      "path": "../../packages/admin-core"
    }
  ]
}
