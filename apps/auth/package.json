{
  "name": "@ingot/auth-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "clean": "rimraf node_modules dist",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@vue/devtools-api": "catalog:",
    "@vueuse/core": "catalog:",
    "axios": "catalog:",
    "beautify-qrcode": "catalog:",
    "crypto-js": "catalog:",
    "element-plus": "catalog:",
    "js-cookie": "catalog:",
    "nprogress": "catalog:",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "qs": "catalog:",
    "tinymce": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "@ingot/shared": "workspace:*"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.4",
    "@iconify-json/carbon": "^1.2.8",
    "@iconify-json/clarity": "^1.2.2",
    "@iconify-json/dashicons": "^1.2.1",
    "@iconify-json/ep": "^1.2.2",
    "@iconify-json/ion": "^1.2.3",
    "@iconify-json/line-md": "^1.2.8",
    "@iconify-json/material-symbols": "^1.2.21",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/mdi-light": "^1.2.2",
    "@iconify-json/tabler": "^1.2.18",
    "@iconify-json/teenyicons": "^1.2.2",
    "@iconify-json/twemoji": "^1.2.2",
    "@iconify/vue": "^5.0.0",
    "@ingot/vite-config": "workspace:*"
  }
