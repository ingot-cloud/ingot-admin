{
  "name": "@ingot/auth-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "import": "./src/plugin.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "clean": "rimraf node_modules dist"
  },
  "dependencies": {
    "@ingot/auth-core": "workspace:*"
  },
  "peerDependencies": {
    "@vueuse/core": "catalog:",
    "element-plus": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@ingot/vite-config": "workspace:*",
    "@vueuse/core": "catalog:",
    "element-plus": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  }
}
