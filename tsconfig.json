{
  "$schema": "https://json.schemastore.org/tsconfig",
  "files": [],
  "references": [
    {
      "path": "./apps/admin"
    },
    {
      "path": "./apps/auth"
    },
    {
      "path": "./plugins/platform"
    },
    {
      "path": "./plugins/security"
    },
    {
      "path": "./plugins/org"
    },
    {
      "path": "./plugins/member"
    },
    {
      "path": "./packages/shared"
    },
    {
      "path": "./packages/http-client"
    },
    {
      "path": "./packages/vite-config"
    },
    {
      "path": "./packages/admin-core"
    },
    {
      "path": "./packages/admin-common"
    }
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": false,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strict": true
  }
}
