{
  "name": "ingot-admin",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter ingot-admin dev && pnpm --filter ingot-login dev",
    "dev:admin": "pnpm --filter ingot-admin dev",
    "dev:login": "pnpm --filter ingot-login dev",
    "dev:with-utils": "concurrently \"pnpm --filter @ingot/utils dev\" \"pnpm --filter ingot-admin dev\" \"pnpm --filter ingot-login dev\"",
    "dev:admin-with-utils": "concurrently \"pnpm --filter @ingot/utils dev\" \"pnpm --filter ingot-admin dev\"",
    "dev:login-with-utils": "concurrently \"pnpm --filter @ingot/utils dev\" \"pnpm --filter ingot-login dev\"",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:apps": "pnpm --filter \"./apps/*\" build",
    "build": "pnpm build:packages && pnpm build:apps",
    "build:admin": "pnpm build:packages && pnpm --filter ingot-admin build",
    "build:login": "pnpm build:packages && pnpm --filter ingot-login build",
    "build:utils": "pnpm --filter @ingot/utils build",
    "build:hooks": "pnpm --filter @ingot/hooks build",
    "type-check": "pnpm --filter \"./apps/*\" type-check",
    "clean": "pnpm --filter \"*\" run clean && rimraf node_modules",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter \"./apps/*\" exec vitest run --passWithNoTests",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "check": "pnpm build:packages && pnpm type-check && pnpm lint:check && pnpm test:unit",
    "format": "prettier --write .",
    "create:package": "node scripts/create-package.mjs",
    "create:package:config": "node scripts/create-package.mjs config"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.17.0 <23",
    "pnpm": "10.12.4"
  },
  "devDependencies": {
    "@iconify/utils": "^3.0.2",
    "@playwright/test": "1.62.1",
    "@rushstack/eslint-patch": "^1.11.0",
    "@tsconfig/node22": "22.0.6",
    "@types/crypto-js": "^4.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.14.0",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@typescript-eslint/utils": "8.68.0",
    "@unocss/preset-wind3": "66.8.1",
    "@unocss/reset": "66.8.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/compiler-sfc": "3.5.42",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "0.9.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-vue": "10.10.0",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.26",
    "postcss-nesting": "14.0.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "unocss": "66.8.1",
    "unplugin-auto-import": "21.1.0",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "pnpm": {
    "overrides": {
      "pinia-plugin-persistedstate>defu": "6.1.5",
      "unplugin>rollup": "4.59.0",
      "webcrypto-liner>elliptic": "6.6.1",
      "yup>lodash": "4.18.0",
      "yup>lodash-es": "4.18.0"
    }
  }
}
