{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": [
      "vite/client",
      "element-plus/global",
      "unplugin-icons/types/vue"
    ],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "allowJs": true,
    "composite": true,
    "skipLibCheck": true,
    "paths": {
      "@ingot/shared": ["../../packages/shared/src/index.ts"],
      "@ingot/shared/crypto": ["../../packages/shared/src/crypto/index.ts"],
      "@ingot/shared/hooks": ["../../packages/shared/src/hooks/index.ts"],
      "@ingot/http-client": ["../../packages/http-client/src/index.ts"],
      "@ingot/admin-common": ["../../packages/admin-common/src/index.ts"]
    }
  }
}
