{
  "name": "@ingot/example-admin-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "自定义管理台主题示例：Token 覆盖、顶栏替换与区域重排",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "import": "./src/style.css",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/style.css",
    "./dist/style.css"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist",
    "type-check": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@ingot/admin-core": "^0.1.0",
    "vue": "^3.5.42"
  }
}
