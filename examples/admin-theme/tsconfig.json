{
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@ingot/admin-core": ["../../packages/admin-core/dist/index.d.ts"],
      "vue": ["../../plugins/platform/node_modules/vue"]
    }
  }
}
