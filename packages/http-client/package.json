{
  "name": "@ingot/http-client",
  "version": "1.0.0",
  "description": "无 UI 依赖的 HTTP Client：Axios 底座、响应归一化、错误分类、取消与可组合拦截器",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf node_modules dist",
    "type-check": "tsc --pretty false --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "axios": "catalog:",
    "qs": "catalog:"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
