{
  "name": "@ingot/shared",
  "version": "1.0.0",
  "description": "Ingot 共享工具：通用 utils、信封加密 crypto、轻量 hooks",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf node_modules dist",
    "type-check": "tsc --pretty false --noEmit"
  },
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "crypto-js": "catalog:",
    "webcrypto-liner": "^1.4.3"
  },
  "peerDependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "vue": "catalog:"
  }
}
